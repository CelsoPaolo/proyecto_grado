# Normaliza finales de línea: LF en el repositorio, nativo en el disco.
# Evita diffs ruidosos por CRLF al trabajar en Windows.
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.png binary
*.jpg binary
*.ico binary
