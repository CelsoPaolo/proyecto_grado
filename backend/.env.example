# Copiar a backend/.env y completar. El .env NO se versiona.
# Ver plan.md seccion 5.4 (secretos).

# --- Django ---------------------------------------------------------
# Generar una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiar-esta-clave-por-una-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL) -------------------------------------
# El rol necesita CREATEDB: pytest crea y destruye test_pcsolution en
# cada ejecucion, y sin ese permiso la prueba de concurrencia de
# RNF-08 no puede correr. Crear rol y base con:
#   CREATE ROLE pcsolution LOGIN PASSWORD '...' CREATEDB;
#   CREATE DATABASE pcsolution OWNER pcsolution ENCODING 'UTF8';
DB_NAME=pcsolution
DB_USER=pcsolution
DB_PASSWORD=cambiar-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# --- CORS -----------------------------------------------------------
# Origen del frontend en desarrollo (Vite). Lista blanca explicita:
# nunca CORS_ALLOW_ALL_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
